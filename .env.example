# Default provider is local heuristic mode, which does not upload documents.
LLM_PROVIDER=heuristic

# Optional OpenAI configuration. Only used when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Leave OPENAI_BASE_URL blank unless you are using a custom OpenAI-compatible endpoint.
OPENAI_BASE_URL=

# CLI defaults
DEFAULT_OUTPUT_DIR=data/output
LOG_LEVEL=INFO

# Optional OCR configuration for scanned PDFs. Leave blank if Tesseract and Poppler are already on PATH.
TESSERACT_CMD=
POPPLER_PATH=
